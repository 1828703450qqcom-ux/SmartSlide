# ========================================
# SlideAI 国内厂商 API 配置
# ========================================
# 使用方法：cp .env.example .env 然后填入你的 API 密钥
# 支持的厂商：DeepSeek / 通义千问 / 豆包 / 智谱GLM / SiliconFlow / 商汤 / MiniMax / Kimi

# AI Provider 格式（lazyllm = 国内多厂商模式）
AI_PROVIDER_FORMAT=lazyllm

# 文本模型配置
TEXT_MODEL=MiniMax-Text-01
TEXT_MODEL_SOURCE=minimax

# 图像模型配置
IMAGE_MODEL=doubao-seedream-3-0
IMAGE_MODEL_SOURCE=doubao

# 图像识别模型配置
IMAGE_CAPTION_MODEL=deepseek-chat
IMAGE_CAPTION_MODEL_SOURCE=deepseek

# ========================================
# 各厂商 API 密钥（填入你的密钥）
# ========================================

# DeepSeek (文本生成) - https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# 通义千问 Qwen (文本+图像) - https://dashscope.console.aliyun.com/
QWEN_API_KEY=

# 豆包 Doubao (文本+图像) - https://console.volcengine.com/ark
DOUBAO_API_KEY=

# 智谱 GLM (文本+图像) - https://open.bigmodel.cn/
GLM_API_KEY=

# SiliconFlow (文本+图像) - https://cloud.siliconflow.cn/
SILICONFLOW_API_KEY=

# 商汤 SenseNova (文本) - https://platform.sensenova.cn/
SENSENOVA_API_KEY=

# MiniMax (文本) - https://platform.minimaxi.com/
MINIMAX_API_KEY=

# Kimi / Moonshot (文本) - https://platform.moonshot.cn/
KIMI_API_KEY=

# ========================================
# 其他配置
# ========================================
LOG_LEVEL=INFO
FLASK_ENV=production
BACKEND_PORT=2000
CORS_ORIGINS=*
OUTPUT_LANGUAGE=zh
SECRET_KEY=change-this-to-a-random-string

# Docker Compose host port for web_app.py (optional)
APP_PORT=5000
